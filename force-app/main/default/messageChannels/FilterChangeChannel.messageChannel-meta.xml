<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Filter Change Channel</masterLabel>
    <isExposed>true</isExposed>
    <description>Channel for communicating filter changes between customResultsFilter and product grid components</description>
    <lightningMessageFields>
        <fieldName>filterId</fieldName>
        <description>The ID of the filter that changed</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>value</fieldName>
        <description>The value that was selected/deselected</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>checked</fieldName>
        <description>Whether the value is checked or unchecked</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>category</fieldName>
        <description>The category this filter applies to</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>action</fieldName>
        <description>The action type: filterchange or clearall</description>
    </lightningMessageFields>
</LightningMessageChannel>
