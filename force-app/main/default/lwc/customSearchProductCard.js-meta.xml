<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Custom Search Product Card</masterLabel>
    <description>A custom product card component for search results in Experience Cloud</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="displayData" type="String" label="Display Data" description="Product display data in JSON format" />
            <property name="configuration" type="String" label="Configuration" description="Component configuration in JSON format" />
            <property name="currentPricebookId" type="String" label="Current Pricebook ID" description="The current active pricebook ID" />
            <property name="specialPricebookIds" type="String" label="Special Pricebook IDs" description="Special pricebook IDs that trigger 'c' suffix (comma-separated)" />
        </targetConfig>
    </targetConfigs>
    <capabilities>
        <capability>lightning__ServerRenderableWithHydration</capability>
    </capabilities>
</LightningComponentBundle>